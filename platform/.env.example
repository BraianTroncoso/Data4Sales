# Configuración de la aplicación.
#
# En Docker NO se usa este archivo: todas estas variables las inyecta
# docker-compose.yml. Existe para poder correr artisan o la suite de tests
# desde el host contra los servicios que el compose expone en localhost.
#
#   cp .env.example .env

APP_NAME=Data4Sales
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Plano de control ──────────────────────────────────────────────
DB_CONNECTION=system

DB_SYSTEM_HOST=127.0.0.1
DB_SYSTEM_PORT=5432
DB_SYSTEM_DATABASE=d4s_system

# ── Plano de datos compartido ─────────────────────────────────────
DB_SHARED_HOST=127.0.0.1
DB_SHARED_PORT=5432
DB_SHARED_DATABASE=d4s_shared

# ── Plano de datos dedicado (plantilla; la base la fija el resolver) ──
DB_DEDICATED_HOST=127.0.0.1
DB_DEDICATED_PORT=5433

# El rol de la aplicación: NO es dueño del esquema y no puede saltarse
# Row-Level Security. Las migraciones corren con d4s_owner, y ese rol sólo
# lo conoce el contenedor de inicialización.
DB_USERNAME=d4s_app
DB_PASSWORD=app_secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
